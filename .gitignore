# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
/SandSort/[Ll]ibrary/
/SandSort/[Tt]emp/
/SandSort/[Oo]bj/
/SandSort/[Bb]uild/
/SandSort/[Bb]uilds/
/SandSort/[Ll]ogs/
/SandSort/[Uu]ser[Ss]ettings/
/SandSort/.idea/

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/SandSort/[Mm]emoryCaptures/

# Recordings can get excessive in size
/SandSort/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /SandSort/[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/SandSort/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
/SandSort/.vs/

# Gradle cache directory
/SandSort/.gradle/

# Firebase directory
/SandSort/[Aa]ssets/Firebase/Plugins/x86_64/
/SandSort/[Aa]ssets/Editor Default Resources/Firebase/
/SandSort/[Aa]ssets/Plugins/tvOS/Firebase/
/SandSort/[Aa]ssets/Plugins/iOS/Firebase/

# Game Analytics directory
/SandSort/[Aa]ssets/GameAnalytics/

# Facebook directory
#SandSort/[Aa]ssets/FacebookSDK/

# MaxSdk directory
/SandSort/[Aa]ssets/MaxSdk/

# RevenueCat directory
/SandSort/[Aa]ssets/RevenueCat/

# Adjust directory
/SandSort/[Aa]ssets/Adjust/Editor/
/SandSort/[Aa]ssets/Adjust/Android/
/SandSort/[Aa]ssets/Adjust/ExampleGUI/
/SandSort/[Aa]ssets/Adjust/iOS/
/SandSort/[Aa]ssets/Adjust/Unity/
/SandSort/[Aa]ssets/Adjust/Windows/


/SandSort/[Aa]ssets/Adjust/
/SandSort/[Aa]ssets/Libs/
/SandSort/[Aa]ssets/Particle VFX/
/SandSort/[Aa]ssets/Plugins/Sirenix
/SandSort/[Aa]ssets/ResourceFolder
/SandSort/[Aa]ssets/Spine Examples
/SandSort/[Aa]ssets/SplineMesh
/SandSort/[Aa]ssets/TextMesh Pro

# Autogenerated VS/MD/Consulo solution and project files
/SandSort/ExportedObj/
/SandSort/.consulo/
/SandSort/*.csproj
/SandSort/*.unityproj
/SandSort/*.sln
/SandSort/*.suo
/SandSort/*.tmp
/SandSort/*.user
/SandSort/*.userprefs
/SandSort/*.pidb
/SandSort/*.booproj
/SandSort/*.svd
/SandSort/*.pdb
/SandSort/*.mdb
/SandSort/*.opendb
/SandSort/*.VC.db

# Unity3D generated meta files
/SandSort/*.pidb.meta
/SandSort/*.pdb.meta
/SandSort/*.mdb.meta

# Unity3D generated file on crash reports
/SandSort/sysinfo.txt

# Builds
/SandSort/*.apk
/SandSort/*.aab
/SandSort/*.unitypackage
/SandSort/*.app

# Crashlytics generated file
/SandSort/crashlytics-build.properties

# Packed Addressables
/SandSort/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/SandSort/[Aa]ssets/[Ss]treamingAssets/aa.meta
/SandSort/[Aa]ssets/[Ss]treamingAssets/aa/*
SandSort/.vscode/settings.json
SandSort/.vscode/launch.json
SandSort/.vscode/extensions.json
SandSort/ProjectSettings/SceneTemplateSettings.json
SandSort/Packages/packages-lock.json
SandSort/Packages/manifest.json
